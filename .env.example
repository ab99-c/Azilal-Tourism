# Required for production authentication/session signing
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# MySQL/TiDB production database
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE?sslaccept=strict

# Required only for activating an existing admin account with email/password
AUTH_BOOTSTRAP_SECRET=replace-with-a-random-bootstrap-secret-at-least-12-characters

# OAuth/Manus integration (required only if Google/Manus OAuth is enabled)
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Optional storage / notifications
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
CONTACT_ADMIN_EMAIL=
CONTACT_FROM_EMAIL=
RESEND_API_KEY=

# AI chatbot (server-side only; never expose provider keys as VITE_* variables)
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
