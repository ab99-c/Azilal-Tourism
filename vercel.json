{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.ts",
      "use": "@vercel/node",
      "config": { "maxDuration": 30 }
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "zeroConfig": true
      }
    }
  ],
  "routes": [
    {
      "src": "/api/trpc/(.*)",
      "dest": "/api/trpc/$1"
    },
    {
      "src": "/api/oauth/(.*)",
      "dest": "/api/oauth/$1"
    },
    {
      "src": "/manus-storage/(.*)",
      "dest": "/api/storage/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
